# ─────────────────────────────────────────────────────────────
# Copia este archivo como .env.local y completa los valores:
#   cp .env.example .env.local
# .env.local NUNCA se sube a GitHub (está en .gitignore).
# ─────────────────────────────────────────────────────────────

# Correo de contacto que se envía en el User-Agent a Open Library.
# Su API pide identificarse; es buena práctica y evita bloqueos.
# Solo se usa en el servidor (no lleva NEXT_PUBLIC_).
APP_CONTACT_EMAIL=tu-correo@example.com

# URL pública de la app (se usa para metadatos y vistas previas al compartir).
# En local: http://localhost:3000  ·  En producción: la URL de Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
